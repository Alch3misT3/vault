{
  "manifest_version": 3,
  "name": "Vault",
  "short_name": "Vault",
  "version": "1.2.0",
  "description": "Fill logins from Vault, the private password manager on your PC.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Vault (Ctrl+Shift+L fills this site)",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "scripts": ["vault-client.js", "background.js"] },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": {
    "fill-login": { "suggested_key": { "default": "Ctrl+Shift+L" }, "description": "Fill the login for this site" },
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+V" } }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*" },
  "browser_specific_settings": { "gecko": { "id": "vault-extension@alch3mist3.github.io", "strict_min_version": "121.0" } }
}
